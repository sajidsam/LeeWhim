# Rongon Luxury E-Commerce Backend Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Atlas Credentials Template
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=rongon_db

# MongoDB Atlas Connection URI Template
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASS>@<CLUSTER_HOST>/rongon_db?retryWrites=true&w=majority

# Security Keys
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
